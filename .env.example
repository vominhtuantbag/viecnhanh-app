EXPO_PUBLIC_SUPABASE_URL=https://YOUR_PROJECT_REF.supabase.co
EXPO_PUBLIC_SUPABASE_ANON_KEY=your_anon_key
# Khóa mới của Supabase dùng được thay cho dòng trên:
# EXPO_PUBLIC_SUPABASE_PUBLISHABLE_KEY=your_publishable_key

# Bản web (Vercel): thêm đúng các tên biến này trong
# Project Settings → Environment Variables, rồi build lại.
# Giá trị được gắn vào file web lúc chạy lệnh export, không đọc lại khi khách mở trang.

# Auth (Phần 3)
# - Tắt Confirm email (Authentication → Providers → Email)
# - Bật Google / Apple
# - Redirect URLs: appmuabanviec://**  ,  exp://**  và  https://TEN-MIEN-VERCEL/**

# Push (tùy chọn — EAS project ID để lấy Expo push token)
# EXPO_PUBLIC_EAS_PROJECT_ID=
#
# Supabase: chạy supabase/migrate_push_notifications.sql
# Database → Extensions → bật pg_net để máy chủ gửi Expo Push.
