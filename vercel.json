{
  "buildCommand": "npm run export:web",
  "outputDirectory": "dist",
  "installCommand": "npm install",
  "framework": null,
  "cleanUrls": true,
  "trailingSlash": false,
  "rewrites": [
    { "source": "/admin(.*)", "destination": "/admin/index.html" },
    { "source": "/landing", "destination": "/landing.html" },
    { "source": "/((?!admin|landing|_expo|assets).*)$", "destination": "/landing.html" }
  ]
}